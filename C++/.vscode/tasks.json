{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build current C++ file",
            "type": "process",
            "command": "/bin/zsh",
            "args": [
                "-c",
                "mkdir -p \"${workspaceFolder}/build/${relativeFileDirname}\" && /usr/bin/clang++ -std=c++20 -Wall -Wextra -g \"${file}\" -o \"${workspaceFolder}/build/${relativeFileDirname}/${fileBasenameNoExtension}\""
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}